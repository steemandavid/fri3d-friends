[Unit]
Description=Fri3d Gotcha game backend (Phase 1)
Documentation=file:///opt/gotcha/server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gotcha
Group=gotcha
WorkingDirectory=/opt/gotcha/server
Environment=GOTCHA_DB=/var/lib/gotcha/gotcha.sqlite3
Environment=GOTCHA_HOST=0.0.0.0
Environment=GOTCHA_PORT=8080
EnvironmentFile=-/etc/gotcha/gotcha.env
ExecStart=/opt/gotcha/venv/bin/python -m gotcha_server.main
Restart=always
RestartSec=2
# §6.1: "Run it under systemd with restart-on-failure."

# The badge protocol tolerates the server disappearing (D6: offline = keep
# playing, queue events), so a hard restart is always safe. Losing the SQLite
# file is not, hence ReadWritePaths rather than a private tmpfs.
StateDirectory=gotcha
StateDirectoryMode=0750
ReadWritePaths=/var/lib/gotcha
# The database holds one `player_key` per badge, which is a credential (§6.2:
# issued once over TLS, never displayed or re-transmitted). systemd would
# otherwise create the state directory 0755 and SQLite the file 0644, leaving
# every key readable by any user on the laptop.
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Port 80 comes later (Phase 5 adds :443 with Let's Encrypt). Until then the
# service runs unprivileged on :8080 and nothing needs CAP_NET_BIND_SERVICE.

[Install]
WantedBy=multi-user.target
